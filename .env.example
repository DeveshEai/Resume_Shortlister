# AI Provider Configuration
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Future Gemini Provider Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./resume_shortlister.db
# For PostgreSQL later: postgresql://user:password@localhost:5432/resume_shortlister

# File Upload Restrictions
MAX_UPLOAD_SIZE_MB=10
